[Unit]
Description=Breakout Explore CORS proxy
After=network-online.target
Wants=network-online.target
 
[Service]
Type=simple
User=jstroud
 
# The proxy only needs to listen on loopback now — Caddy terminates TLS on 443
# and forwards to it. Note: systemd gives the service a clean environment, so
# the stray HOST=x2.hey.icu from your interactive shell is NOT inherited here;
# we pin it to 127.0.0.1 explicitly anyway.
Environment=HOST=127.0.0.1
Environment=PORT=3333
Environment=RPC_CONF=/home/jstroud/.breakout/breakout.conf
Environment=AUTH_SECRET=REPLACE_WITH_openssl_rand_hex_32
 
# ---- adjust these two paths to where things actually live ----
# `which node` on the box tells you the ExecStart path.
WorkingDirectory=/home/jstroud/breakout-proxy
ExecStart=/usr/bin/node /home/jstroud/breakout-proxy/breakout-cors-proxy.js
 
Restart=on-failure
RestartSec=3
 
# light hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
 
[Install]
WantedBy=multi-user.target
